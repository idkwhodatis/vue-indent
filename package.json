{
  "name": "vue-indent",
  "displayName": "vue-indent",
  "description": "Per-region Vue indentation guides and optional indent commands, without changing native Tab/Enter.",
  "version": "1.0.0",
  "publisher": "idkwhodatis",
  "repository": "https://github.com/idkwhodatis/vue-indent",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:vue"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vue-indent.activate",
        "title": "Vue Indent: Refresh Guides"
      },
      {
        "command": "vue-indent.indent",
        "title": "Vue Indent: Indent Selected Lines",
        "enablement": "editorLangId == vue && config.vueIndent.commandsEnabled"
      },
      {
        "command": "vue-indent.outdent",
        "title": "Vue Indent: Outdent Selected Lines",
        "enablement": "editorLangId == vue && config.vueIndent.commandsEnabled"
      }
    ],
    "configuration": {
      "title": "Vue Indent",
      "properties": {
        "vueIndent.templateIndentSize": {
          "type": "integer",
          "default": 2,
          "description": "Visual guide interval and explicit command step inside template blocks. Also used as editor width in legacyEditorOptions mode.",
          "minimum": 1,
          "maximum": 32,
          "scope": "resource"
        },
        "vueIndent.styleIndentSize": {
          "type": "integer",
          "default": 2,
          "description": "Visual guide interval and explicit command step inside style blocks. Also used as editor width in legacyEditorOptions mode.",
          "minimum": 1,
          "maximum": 32,
          "scope": "resource"
        },
        "vueIndent.scriptIndentSize": {
          "type": "integer",
          "default": 4,
          "description": "Visual guide interval and explicit command step inside script blocks. Also used as editor width in legacyEditorOptions mode.",
          "minimum": 1,
          "maximum": 32,
          "scope": "resource"
        },
        "vueIndent.mode": {
          "type": "string",
          "enum": [
            "guides",
            "legacyEditorOptions",
            "off"
          ],
          "default": "guides",
          "scope": "resource",
          "description": "Guides preserve native editing. legacyEditorOptions opts into cursor-dependent editor tab/indent widths. off hides guides."
        },
        "vueIndent.commandsEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Enable explicit region-aware indent/outdent commands. No default keybindings; native Tab/Enter stay unchanged."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "vscode-test",
    "package": "vsce package --out vue-indent.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.88.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.45"
  }
}
