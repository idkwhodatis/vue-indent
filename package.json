{
  "name": "vue-indent",
  "displayName": "vue-indent",
  "description": "Per-block indentation widths for Vue single-file components, preserving your spaces/tabs preference.",
  "version": "1.0.0",
  "publisher": "idkwhodatis",
  "repository": "https://github.com/idkwhodatis/vue-indent",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:vue"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vue-indent.activate",
        "title": "activate vue-indent"
      }
    ],
    "configuration": {
      "title": "Vue Indent",
      "properties": {
        "vueIndent.templateIndentSize": {
          "type": "integer",
          "default": 2,
          "description": "Indentation/tab display width inside template blocks. Preserves spaces/tabs preference.",
          "minimum": 1,
          "maximum": 32,
          "scope": "resource"
        },
        "vueIndent.styleIndentSize": {
          "type": "integer",
          "default": 2,
          "description": "Indentation/tab display width inside style blocks. Preserves spaces/tabs preference.",
          "minimum": 1,
          "maximum": 32,
          "scope": "resource"
        },
        "vueIndent.scriptIndentSize": {
          "type": "integer",
          "default": 4,
          "description": "Indentation/tab display width inside script blocks. Preserves spaces/tabs preference.",
          "minimum": 1,
          "maximum": 32,
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "vscode-test",
    "package": "vsce package --out vue-indent.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.88.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.45"
  }
}
